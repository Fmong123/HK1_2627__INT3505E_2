{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loan",
  "type": "object",
  "required": ["id", "member_id", "borrowed_at", "due_at", "items"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "member_id": {"type": "integer", "minimum": 1},
    "borrowed_at": {"type": "string", "format": "date-time"},
    "due_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "copy_id", "returned_at"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "copy_id": {"type": "integer", "minimum": 1},
          "returned_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

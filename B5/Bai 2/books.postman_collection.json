{
  "info": {
    "name": "B5 - Bai2 Books API",
    "description": "Run the full collection in order. The first four requests add books with a new genre and ISBNs for each run. Checks cover offset, cursor, genre, multi-key sort, ties and invalid inputs. Start the Flask API first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. POST - Them Python (1)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString().slice(-9);",
              "pm.collectionVariables.set(\"genre\", \"test-\" + runId);",
              "pm.collectionVariables.set(\"isbn_prefix\", \"978\" + runId);",
              "pm.collectionVariables.unset(\"next_cursor\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test(\"Du lieu sach dung\", function () { pm.expect(body.title).to.eql(\"Python\"); pm.expect(body.price).to.eql(120000); pm.expect(body.genre).to.eql(pm.collectionVariables.get(\"genre\")); });",
              "pm.collectionVariables.set(\"python_id\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/books",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Python\",\n  \"isbn\": \"{{isbn_prefix}}1\",\n  \"price\": 120000,\n  \"genre\": \"{{genre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02. POST - Them Flask (2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test(\"Du lieu sach dung\", function () { pm.expect(body.title).to.eql(\"Flask\"); pm.expect(body.price).to.eql(150000); pm.expect(body.genre).to.eql(pm.collectionVariables.get(\"genre\")); });",
              "pm.collectionVariables.set(\"flask1_id\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/books",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Flask\",\n  \"isbn\": \"{{isbn_prefix}}2\",\n  \"price\": 150000,\n  \"genre\": \"{{genre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03. POST - Them Flask (3)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",

              "pm.collectionVariables.set(\"flask2_id\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/books",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Flask\",\n  \"isbn\": \"{{isbn_prefix}}3\",\n  \"price\": 150000,\n  \"genre\": \"{{genre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04. POST - Them API (4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test(\"Du lieu sach dung\", function () { pm.expect(body.title).to.eql(\"API\"); pm.expect(body.price).to.eql(150000); pm.expect(body.genre).to.eql(pm.collectionVariables.get(\"genre\")); });",
              "pm.collectionVariables.set(\"api_id\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/books",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API\",\n  \"isbn\": \"{{isbn_prefix}}4\",\n  \"price\": 150000,\n  \"genre\": \"{{genre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05. GET - Offset trang 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Dung sach va thu tu\", function () { pm.expect(body.data.map(b => b.id)).to.eql([pm.collectionVariables.get(\"python_id\"), pm.collectionVariables.get(\"flask1_id\")]); });",
              "pm.test(\"Tong 4 sach, con trang sau\", function () { pm.expect(body.pagination.total).to.eql(4); pm.expect(body.pagination.has_next).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/books?strategy=offset&genre={{genre}}&sort=id&offset=0&limit=2"
      }
    },
    {
      "name": "06. GET - Offset trang 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Dung sach va thu tu\", function () { pm.expect(body.data.map(b => b.id)).to.eql([pm.collectionVariables.get(\"flask2_id\"), pm.collectionVariables.get(\"api_id\")]); });",
              "pm.test(\"Trang cuoi\", function () { pm.expect(body.pagination.total).to.eql(4); pm.expect(body.pagination.has_next).to.eql(false); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/books?strategy=offset&genre={{genre}}&sort=id&offset=2&limit=2"
      }
    },
    {
      "name": "07. GET - Genre va sort nhieu truong",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Dung sach va thu tu\", function () { pm.expect(body.data.map(b => b.id)).to.eql([pm.collectionVariables.get(\"api_id\"), pm.collectionVariables.get(\"flask1_id\"), pm.collectionVariables.get(\"flask2_id\"), pm.collectionVariables.get(\"python_id\")]); });",
              "pm.test(\"Chi tra dung genre\", function () { pm.expect(body.data.every(b => b.genre === pm.collectionVariables.get(\"genre\"))).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/books?genre={{genre}}&sort=-price,title"
      }
    },
    {
      "name": "08. GET - Cursor trang 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Dung sach va thu tu\", function () { pm.expect(body.data.map(b => b.id)).to.eql([pm.collectionVariables.get(\"api_id\"), pm.collectionVariables.get(\"flask1_id\")]); });",
              "pm.test(\"Co cursor trang tiep\", function () { pm.expect(body.pagination.has_more).to.eql(true); pm.expect(body.pagination.next_cursor).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"next_cursor\", body.pagination.next_cursor);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/books?strategy=cursor&genre={{genre}}&sort=-price,title&limit=2"
      }
    },
    {
      "name": "09. GET - Cursor trang 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Dung sach va thu tu\", function () { pm.expect(body.data.map(b => b.id)).to.eql([pm.collectionVariables.get(\"flask2_id\"), pm.collectionVariables.get(\"python_id\")]); });",
              "pm.test(\"Trang cuoi, khong bo sot sach trung gia va ten\", function () { pm.expect(body.pagination.has_more).to.eql(false); pm.expect(body.pagination.next_cursor).to.eql(null); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/books?strategy=cursor&genre={{genre}}&sort=-price,title&limit=2&cursor={{next_cursor}}"
      }
    },

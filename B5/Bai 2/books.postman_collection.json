              "const body = pm.response.json();",
              "pm.test(\"Danh sach rong\", function () { pm.expect(body.data).to.eql([]); pm.expect(body.pagination.total).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/books?genre={{genre}}-missing"
      }
    },
